# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartoffer
DB_USER=smartoffer_user
DB_PASSWORD=troque_esta_senha

# Segurança / JWT
# Gere um segredo forte, por exemplo: openssl rand -hex 64
JWT_SECRET=troque_este_segredo_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS (origem permitida do front-end)
CORS_ORIGIN=http://localhost:3000

# Inteligência Artificial (Google Gemini)
# Gere sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=coloque_sua_chave_do_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash
